#python3 solution for leetcode problem 91 Decode Ways
class Solution:
    def numDecodings(self, s: str) -> int:
        n=len(s)
        if s[0]=='0':
            return 0
        if n==1:
            return 1

        dp=[0]*(n+1)
        dp[0]=1
        dp[1]=1

        for i in range (2, n+1):
            single=int(s[i-1])
            if (single!=0):
                dp[i]=dp[i]+dp[i-1]
            double=int(s[i-2:i])
            if (10<=double and double<=26):
                dp[i]=dp[i]+dp[i-2]
        return dp[n]   

    
        
